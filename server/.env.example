# 数据库配置
DB_HOST=192.168.0.141
DB_PORT=3306
DB_USER=baozihao
DB_PASSWORD=你的数据库密码
DB_NAME=baozihao

# JWT 密钥（用 node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" 生成）
JWT_ACCESS_SECRET=请生成一个64位随机字符串替换这里
JWT_REFRESH_SECRET=请生成另一个64位随机字符串替换这里
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 允许的前端来源（开发时用 localhost，生产时用 Netlify 域名）
CORS_ORIGIN=http://localhost:5173

# 端口
PORT=3000
